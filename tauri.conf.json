{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Device Manager",
  "version": "1.0.0",
  "identifier": "com.soto.androiddevicemanager",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Android Device Manager",
        "width": 1240,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
